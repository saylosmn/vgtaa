<?xml version="1.0" encoding="utf-8"?>
<!-- Нэвтрэлтийн token WebView-ийн localStorage-д байдаг тул нөөцлөл, төхөөрөмж хооронд шилжүүлэхгүй -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
